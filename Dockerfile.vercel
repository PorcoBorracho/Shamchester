# Shamchester United · imagen para Vercel (Container Runtime) y para cualquier Docker
# 1) Compila el WAR con Maven
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q package -DskipTests

# 2) Tomcat 10.1 (Jakarta EE 10, como Struts 7 y Spring 6) solo con el WAR
FROM tomcat:10.1-jre21
RUN rm -rf /usr/local/tomcat/webapps/* /usr/local/tomcat/webapps.dist
COPY --from=build /src/target/shamchester.war /usr/local/tomcat/webapps/ROOT.war

# Vercel solo permite escribir en /tmp
ENV LOG_DIR=/tmp/logs \
    JAVA_OPTS="-XX:+UseSerialGC -XX:MaxRAMPercentage=75 -XX:TieredStopAtLevel=1 -Djava.security.egd=file:/dev/urandom"

EXPOSE 8080
# Tomcat escucha en $PORT (Vercel) o en 8080 por defecto
CMD ["sh", "-c", "sed -i \"s/port=\\\"8080\\\"/port=\\\"${PORT:-8080}\\\"/\" conf/server.xml && exec catalina.sh run"]
