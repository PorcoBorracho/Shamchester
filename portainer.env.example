# Variables para el stack de Portainer (Stacks > stack > Environment variables > Load variables from .env file)
# Copia este archivo, rellénalo y súbelo en Portainer. NO lo subas al repositorio con valores reales.
WEB_PORT=8080
APP_NAME=Shamchester United
APP_DEFAULT_LOCALE=gl
NEXT_MATCH_DATE=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=
SOCIAL_YOUTUBE_URL=
CONTACT_EMAIL=
MAP_URL=
SUPABASE_DB_HOST=<host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<user>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_POOL_SIZE=5
LOG_LEVEL=info
