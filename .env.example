# ------------------------------------------------------------
#  Variables de entorno del proxecto Shamchester United
#  Copia este archivo como .env y cambia los valores.
#  Las variables del sistema tienen prioridad sobre este archivo.
# ------------------------------------------------------------

# Aplicación
APP_NAME=Shamchester United
APP_ENV=development
APP_DEFAULT_LOCALE=gl

# Próximo partido (formato ISO 8601 con zona horaria)
NEXT_MATCH_DATE=2026-11-29T17:00:00+01:00

# Redes sociales y contacto
SOCIAL_INSTAGRAM_URL=https://instagram.com/
SOCIAL_X_URL=https://x.com/
SOCIAL_YOUTUBE_URL=https://youtube.com/
CONTACT_EMAIL=oficina@shamchester.gal

# Ubicación del campo
MAP_URL=https://www.openstreetmap.org/
